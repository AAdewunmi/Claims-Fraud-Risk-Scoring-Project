# path: docker/Dockerfile.prod
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
  && pip install --no-cache-dir gunicorn==22.0.0

COPY . /app

# Ensure the entrypoint is executable before switching user.
RUN chmod +x /app/docker/entrypoint.sh

# Create a non-root runtime user.
RUN useradd --create-home --shell /bin/bash appuser \
  && mkdir -p /app/staticfiles /app/media /app/artifacts \
  && chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

ENTRYPOINT ["/app/docker/entrypoint.sh"]
CMD ["gunicorn", "policylens.config.wsgi:application", "--config", "docker/gunicorn/gunicorn.conf.py"]
